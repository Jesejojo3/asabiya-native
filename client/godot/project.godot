; Asabiya Native — cliente 3D (Godot 4.7.2-stable, Forward+).
; La simulación vive exclusivamente en Go; este proyecto sólo representa datos.

config_version=5

[application]

config/name="Asabiya Native"
config/description="Cliente 3D de observación histórica para Asabiya Native"
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.055, 0.067, 0.086, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/energy_saving/keep_screen_on=false
window/dpi/allow_hidpi=true

[gui]

theme/default_font_antialiasing=1
theme/default_font_subpixel_positioning=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.086, 1)
